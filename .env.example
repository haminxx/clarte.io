# Copy to .env.local and fill in your values. Never commit .env.local.

# Vapi.ai (Tier 1 - voice only)
# Get from https://dashboard.vapi.ai
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# LiveKit + screen share / camera (Tier 2/3)
# NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
# NEXT_PUBLIC_VOICE_AGENT_URL=https://your-app.onrender.com

# Firebase (for auth, dashboard)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

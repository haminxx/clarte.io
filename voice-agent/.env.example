# LiveKit (from LiveKit Cloud)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI Realtime API (STT + LLM)
OPENAI_API_KEY=

# Model selection (Standard: gpt-realtime-mini, Pro: gpt-realtime-1.5)
# OPENAI_REALTIME_MODEL=gpt-realtime-1.5
# OPENAI_REALTIME_MODEL=gpt-realtime-mini

# Secretary vision (screen/camera analysis). gpt-4o-mini for cost, gpt-4o for quality
# SECRETARY_VISION_MODEL=gpt-4o
# SECRETARY_VISION_MODEL=gpt-4o-mini

# Deepgram Aura TTS (required for agent to speak)
DEEPGRAM_API_KEY=

# Exa (for research tool)
EXA_API_KEY=

# Enable Secretary in full LiveKit Room (Pro path)
# ENABLE_TWO_AGENT=true

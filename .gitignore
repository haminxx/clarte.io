# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (but allow .env.example for documentation)
.env*
!.env.example

# backend venv
backend/.venv

# vercel
.vercel

# firebase
.firebase/

# typescript
*.tsbuildinfo
next-env.d.ts

# Tauri / Rust
apps/desktop/src-tauri/target/
apps/desktop/dist/

# Chrome extension
apps/chrome-extension/dist/

# iOS
apps/ios/*.xcodeproj/xcuserdata/
apps/ios/*.xcworkspace/xcuserdata/
DerivedData/

# Python
__pycache__/
*.pyc

# ASL pipeline collected data
src/data/

# Cursor
.cursor/
